# Copy this file to ".env" and fill in your Supabase project values.
# Both are safe to expose in the browser (the anon key is meant to be public;
# security is enforced by Row Level Security + the SECURITY DEFINER functions).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
